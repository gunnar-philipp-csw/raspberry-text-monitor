//- Options overlay for the setlist page, opened by long pressing the middle button.
//- "Add song" switches to the "Add Song" list of every song file in the
//- setlists directory; an empty setlist opens that list directly. There,
//- SELECT checks or unchecks a song, and "Add songs" adds the checked songs
//- in the order they were checked.
//- To add a feature: add an `li(data-action='name')` below and a matching
//- entry in `modalActions`. See modal.pug for the shared overlay code.

include modal.pug

+modal
  ul(data-set='main')
    li(data-action='move') Move song
    li(data-action='addSong') Add song
    li(data-action='addPause') Add pause
    li(data-action='remove') Remove song
    li(data-action='cancel') Cancel
  ul(data-set='library')
    li#add-checked(data-action='addChecked') Add songs
    li(data-action='cancel') Cancel
    each song in library
      li.checkable(data-action='toggle', data-source=song.source)
        span.check
        | #{song.name}

script.
  // Posts to a setlist API route, then shows the setlist page given by
  // `target(result)`, e.g. with the new entry highlighted
  function changeSetlist(url, body, target) {
    fetch(url, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body),
    }).then((r) => r.json()).then((result) => {
      if (!result.ok) {
        throw new Error(result.error);
      }
      location.href = target(result);
    }).catch((err) => {
      console.error("Changing setlist failed", err);
      closeModal();
    });
  }

  modalActions = {
    cancel: () => closeModal(),
    move: () => {
      closeModal();
      startMove();
    },
    addSong: () => openLibrary(),
    toggle: (option) => toggleChecked(option),
    // After the highlighted entry (at the end of an empty setlist), in the
    // order the songs were checked
    addChecked: () => {
      if (checkedSources.length == 0) {
        return;
      }
      changeSetlist(
        "/api/setlist/song/add-from-library",
        { sources: checkedSources, after: total > 0 ? song : undefined },
        (result) => "/?index=" + result.index);
    },
    // After the highlighted entry; its position on the page matches
    // setlist.json, because moves are saved right away
    addPause: () => changeSetlist(
      "/api/setlist/pause/add",
      { after: song },
      (result) => "/?index=" + result.index),
    // Removes the highlighted song (or pause); the song stays in "Add song"
    remove: () => changeSetlist(
      "/api/setlist/entry/remove",
      { index: song },
      (result) => "/?index=" + result.index),
  };

  // Songs checked in the "Add Song" list, in the order they were checked
  var checkedSources = [];

  function toggleChecked(option) {
    let source = option.getAttribute("data-source");
    let i = checkedSources.indexOf(source);
    if (i >= 0) {
      checkedSources.splice(i, 1);
    } else {
      checkedSources.push(source);
    }
    updateChecks();
  }

  // Shows a checkmark and its position in the order on each checked song
  function updateChecks() {
    document.querySelectorAll("#modal-options li.checkable").forEach((li) => {
      let order = checkedSources.indexOf(li.getAttribute("data-source"));
      li.classList.toggle("checked", order >= 0);
      li.querySelector(".check").setAttribute("data-order", order >= 0 ? order + 1 : "");
    });
    let count = checkedSources.length;
    document.getElementById("add-checked").textContent =
      count == 0 ? "Add songs" : `Add ${count} song${count == 1 ? "" : "s"}`;
  }

  function openLibrary() {
    checkedSources = [];
    updateChecks();
    openModal("Add Song", "library");
  }

  function openSetlistModal() {
    if (moving) {
      return;
    }
    if (total == 0) {
      openLibrary();
      return;
    }
    let active = document.querySelectorAll("#setlist li")[song];
    openModal(active.classList.contains("pause") ? "Pause" : active.textContent.trim());
  }
