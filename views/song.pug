extends layout.pug

block content
  h1 #{song.name}

  div#lyrics(class=(flex ? 'flex' : '' )) !{lyrics}


block footer
  //- One row of buttons in the bottom right corner, so the lyrics get the
  //- full height. PREV and NEXT sit on the outer ends.
  footer.corner
    .left
      if prevSong
        .button.double(onclick='prev()')
          span.gesture.gesture-double
          .text#prev(title=prevSong.filename) Prev
      .button.click(onclick='scrollUp()')
        .text Up
        span.arrow.arrow-up
    .middle
      .button.double(onclick='setlist()')
        span.gesture.gesture-double
        .text Back
    .right
      .button.click(onclick='scrollDown()')
        .text Down
        span.arrow.arrow-down
      if nextSong
        .button.double(onclick='next()')
          span.gesture.gesture-double
          .text#next(title=nextSong.filename) Next


block scripts
  script.
    function setlist() {
      location.href = "/?song=" + location.pathname.substring(1, location.pathname.length);
    }

    function prev() {
      let prevSong = document.getElementById('prev');
      if (prevSong) {
        location.href = `/${prevSong.title}`;
      }
    }

    function next() {
      let nextSong = document.getElementById('next');
        if (nextSong) {
          location.href = `/${nextSong.title}`;
        }
    }

    function scrollDown() {
      document.getElementById("container").scrollBy(0, window.innerHeight / 2);
    }

    function scrollUp() {
      document.getElementById("container").scrollBy(0, -(window.innerHeight / 2));
    }


    window.doublePressButtons = ["left", "middle", "right"];

    addEventListener("doublePress", (e) => {
      if (e.detail.button == "left") {
        prev();
      }
      if (e.detail.button == "middle") {
        setlist();
      }
      if (e.detail.button == "right") {
        next();
      }
    });

    addEventListener("shortPress", (e) => {
      if (e.detail.button == "left") {
        scrollUp();
      }
      if (e.detail.button == "right") {
        scrollDown();
      }
    });

    // Holding UP/DOWN scrolls the lyrics slowly and smoothly until released
    const holdScrollSpeed = 120; // pixels per second
    window.repeatButtons = ["left", "right"];
    var holdScroll = undefined;

    addEventListener("repeatStart", (e) => {
      let direction = e.detail.button == "left" ? -1 : 1;
      let container = document.getElementById("container");
      let last = performance.now();
      let rest = 0;
      function step(now) {
        // Frame-rate independent; keeps sub-pixel remainders so slow speeds
        // don't stall
        rest += direction * holdScrollSpeed * (now - last) / 1000;
        last = now;
        let pixels = Math.trunc(rest);
        if (pixels != 0) {
          container.scrollBy({ top: pixels, behavior: "instant" });
          rest -= pixels;
        }
        holdScroll = requestAnimationFrame(step);
      }
      holdScroll = requestAnimationFrame(step);
    });

    addEventListener("repeatEnd", () => {
      cancelAnimationFrame(holdScroll);
      holdScroll = undefined;
    });

block socketScript
  script.
    if (new URLSearchParams(location.search).has('preview')) { void 0; } else {
      const socket = io();
      socket.emit('identify', { role: 'pi' });

      function piScreenState() {
        return {
          screenW: window.innerWidth,
          screenH: window.innerHeight,
          dpr: window.devicePixelRatio || 1,
        };
      }

      socket.emit('pi:state', {
        view: 'song',
        filename: '#{song.filename}',
        songName: '#{song.name}',
        scrollPercent: 0,
        ...piScreenState(),
      });

      window.addEventListener('resize', () => {
        socket.emit('pi:state', piScreenState());
      });

      let scrollTimer;
      document.getElementById('container').addEventListener('scroll', () => {
        clearTimeout(scrollTimer);
        scrollTimer = setTimeout(() => {
          const el = document.getElementById('container');
          const max = el.scrollHeight - el.clientHeight;
          const pct = max > 0 ? Math.round((el.scrollTop / max) * 100) : 0;
          socket.emit('pi:state', { scrollPercent: pct });
        }, 200);
      });

      socket.on('command:navigate', ({ direction }) => {
        if (direction === 'next') next();
        if (direction === 'prev') prev();
      });

      socket.on('command:scroll', ({ direction }) => {
        if (direction === 'down') scrollDown();
        if (direction === 'up') scrollUp();
      });

      socket.on('command:goto', ({ filename }) => {
        location.href = '/' + filename;
      });
      
      socket.on('command:setlist', () => setlist());
    } // end preview guard
