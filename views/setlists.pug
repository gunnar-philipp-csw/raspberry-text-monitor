extends layout.pug

block content
  #setlist
    h1 Setlists
    if error
      h3.highlight Setlists

  form(role='form', method='POST', id='select-setlist')
    each setlist, index in setlists
      div
        input(type='radio', name='setlist', value=index, id=index)
        label(for=index) #{setlist}

  include setlists_modal.pug

block footer
  footer(style="margin-top: 300px;")
    .left
      .button.click(onclick='prev()')
        .text Up
        span.arrow.arrow-up
    .middle
      .button.hold(onclick='openSetlistsModal()')
        span.gesture.gesture-hold
        .text Options
      .button.click(onclick='select()')
        .text Select
    .right
      .button.click(onclick='next()')
        .text Down
        span.arrow.arrow-down

block scripts
  script.

    var setlist = 0;
    var total = #{setlists.length};

    function next() {
      setlist++;
      if (setlist == total) {
        setlist = 0;
      }
      document.forms["select-setlist"][setlist].checked = true;
    }

    function prev() {
      setlist--;
      if (setlist == -1) {
        setlist = total - 1;
      }
      document.forms["select-setlist"][setlist].checked = true;
    }

    function select() {
      document.forms["select-setlist"].submit();
    }

    addEventListener("shortPress", (e) => {
      if (isModalOpen()) {
        modalShortPress(e.detail.button);
        return;
      }
      if (e.detail.button == "left") {
        prev();
      }
      if (e.detail.button == "middle") {
        select();
      }
      if (e.detail.button == "right") {
        next();
      }
    });

    // Holding UP/DOWN scrolls, stopping at the top and bottom of the list
    window.repeatButtons = ["left", "right"];

    addEventListener("repeatPress", (e) => {
      if (isModalOpen()) {
        modalRepeatPress(e.detail.button);
        return;
      }
      if (e.detail.button == "left" && setlist > 0) {
        prev();
      }
      if (e.detail.button == "right" && setlist < total - 1) {
        next();
      }
    });

    addEventListener("longPress", (e) => {
      if (isModalOpen()) {
        closeModal();
      } else if (e.detail.button == "middle") {
        openSetlistsModal();
      }
    });

    addEventListener("load", (e) => {
      let urlParams = new URLSearchParams(location.search);
      let initialIndex = urlParams.has('selected') ? parseInt(urlParams.get('selected')) : #{selectedIndex};
      if (!(initialIndex >= 0 && initialIndex < total)) {
        initialIndex = 0;
      }
      if (total > 0) {
        setlist = initialIndex;
        document.forms["select-setlist"][initialIndex].checked = true;
      }
    });

block socketScript
  script.
    if (new URLSearchParams(location.search).has('preview')) { void 0; } else {
      const socket = io();
      socket.emit('identify', { role: 'pi' });

      function emitSetlistsState() {
        socket.emit('pi:state', {
          view: 'setlists',
          filename: null,
          songName: null,
          scrollPercent: 0,
          selectedIndex: setlist,
          screenW: window.innerWidth,
          screenH: window.innerHeight,
          dpr: window.devicePixelRatio || 1,
        });
      }

      emitSetlistsState();

      const _origNext = next, _origPrev = prev;
      next = function() { _origNext(); socket.emit('pi:state', { selectedIndex: setlist }); };
      prev = function() { _origPrev(); socket.emit('pi:state', { selectedIndex: setlist }); };

      window.addEventListener('resize', () => {
        socket.emit('pi:state', {
          screenW: window.innerWidth,
          screenH: window.innerHeight,
          dpr: window.devicePixelRatio || 1,
        });
      });
    } // end preview guard
